# ──── DTZ-Bot Environment Variables ────────────────────────────────
# Rename this file to .env and fill in your values
# NEVER commit the .env file to Git - it's already in .gitignore

# 1. Get from @BotFather on Telegram (free)
# Steps: Open Telegram → Search @BotFather → /newbot → Follow prompts
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# 2. Get FREE from https://aistudio.google.com → "Get API Key" (free forever)
# Steps: Visit https://aistudio.google.com/app/apikey → Sign in → Create API key
GEMINI_API_KEY=your-gemini-api-key-here
